# ---- Secrets & credentials (security critical) ----
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.pkcs8
*.keystore
*.jks
id_rsa*
secrets/
credentials/
wallet*.json
keystore/
*private*key*
kalshi_*.pem
polymarket_*.json
# The runbook tells the operator to put an API auth token in this exact file. The
# `.env.*` rule above does not cover it: gitignore matches that pattern against the
# basename `trial.env`, which does not begin with `.env`. So name it exactly, and keep
# the committed example beside it.
config/trial.env
config/*.env
!config/*.env.example

# ---- Python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
dist/
build/
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# ---- Data / local state ----
*.db
*.sqlite
*.sqlite3
# The run journal is a sidecar beside the database — local run history, same as the
# database itself, and `*.db` does not match `<name>.db.journal`.
*.journal
data/
logs/
*.log

# ---- Operator-supplied reference documents ----
# Venue terms are read and summarized into docs/compliance.md; the source PDFs are not
# ours to redistribute.
*.pdf

# ---- Generated analysis artifacts ----
# graphify-out/ currently holds only a local AST cache, not a retained artifact.
graphify-out/

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/

# Local files excluded from GitHub uploads
.DS_Store
.claude/
.codex/
.serena/
graphify-out/
node_modules/
.venv/
venv/
__pycache__/
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.db
*.sqlite
*.sqlite3
*.journal
