# =============================================================================
# Supervised REST-only paper trial — dedicated configuration
# =============================================================================
#
# Copy to `config/trial.env`, fill in the two market ids, and run the trial with it:
#
#     set -a && . ./config/trial.env && set +a
#     .venv/bin/event-arb doctor
#
# Follow docs/paper-trial-runbook.md, which is the procedure this file belongs to.
# Nothing here grants approval to trade a pair: a pair becomes tradable only when a
# human who has read both rulebooks approves it through the dashboard, and the
# preflight refuses a paper-trading run that has no approved pair.
#
# Reviewed revision : branch smoke-test-preflight-blocked, base commit c4f0cf0
#                     plus the uncommitted durable-accounting work (see the runbook's
#                     "Configuration identity" section — record the exact `git rev-parse
#                     HEAD` and `git status --porcelain` hash you actually ran).
# Configuration id  : trial-rest-us-v1
#
# -----------------------------------------------------------------------------
# 1. Posture: paper only, and structurally unable to be otherwise
# -----------------------------------------------------------------------------
# No execution adapter in this build can place an order; this setting is the second
# lock, not the only one. `event-arb doctor` verifies the refusal at runtime.
EVENT_ARB_TRADING_ENABLED=false

# -----------------------------------------------------------------------------
# 2. Market data: Kalshi production public REST + Polymarket US public REST
# -----------------------------------------------------------------------------
# Both are readable without credentials. WebSocket is deliberately NOT used: Kalshi
# signs its handshake even for public channels and Polymarket US streaming requires
# the authenticated API, so a REST-only trial needs no keys at all. The preflight
# refuses `websocket` with `polymarket.product=us` rather than starting a stream that
# cannot authenticate.
EVENT_ARB_DATA_SOURCE=live
EVENT_ARB_INGESTION_MODE=rest_polling
EVENT_ARB_KALSHI__ENVIRONMENT=prod
EVENT_ARB_POLYMARKET__PRODUCT=us

# Leave Kalshi credentials unset. Public market data needs none, and an unused key in
# the environment is a credential at risk for no benefit.
# EVENT_ARB_KALSHI__API_KEY_ID=
# EVENT_ARB_KALSHI__PRIVATE_KEY_PATH=

# Per-venue client rate limits. The trial's own demand is far below these (see the
# request budget in the runbook); they are the ceiling, not the plan.
EVENT_ARB_KALSHI__REQUESTS_PER_SECOND=5
EVENT_ARB_POLYMARKET__REQUESTS_PER_SECOND=5

# -----------------------------------------------------------------------------
# 3. Scope: exactly one explicitly named pair
# -----------------------------------------------------------------------------
# Leaving this empty is the single configuration that turns a bounded trial into a
# venue-wide listing — discovery falls through to an unbounded GET /markets and pairs
# are generated from whatever came back. The live preflight BLOCKS on it.
#
# The ids below are placeholders and are deliberately unusable: they will not resolve
# at either venue, so a run started before real ids are filled in fails at discovery
# rather than trading something nobody chose. Replace both, and record in the runbook
# where each id came from.
EVENT_ARB_TRIAL__WATCHED_PAIRS='[{"kalshi_market_id":"REPLACE-ME-KALSHI-TICKER","polymarket_market_id":"REPLACE-ME-POLYMARKET-CONDITION-ID","outcomes_inverted":false,"note":"PLACEHOLDER — not reviewed, not approved"}]'

# -----------------------------------------------------------------------------
# 4. Cadence and freshness
# -----------------------------------------------------------------------------
# One watched pair is two markets, so one refresh batch is two requests. At a 5 s
# cycle that is 0.4 req/s per venue against a 5 req/s ceiling.
#
# `max_book_age_ms` must be at least what this cadence can satisfy: about one refresh
# batch plus clock tolerance, because the runtime refreshes and then scans inside one
# cycle and skips the scan when the refresh fails. `event-arb doctor` prints the
# required figure for this configuration and the freshness check refuses a bound below
# it. 2000 ms is comfortable for two markets; do not raise it to paper over a slow
# feed — a higher bound means acting on older prices.
EVENT_ARB_TRIAL__ENABLED=true
EVENT_ARB_TRIAL__REFRESH_INTERVAL_SECONDS=5
EVENT_ARB_TRIAL__SCAN_INTERVAL_SECONDS=5
EVENT_ARB_TRIAL__CLOCK_TOLERANCE_SECONDS=0.5
EVENT_ARB_OPPORTUNITY__MAX_BOOK_AGE_MS=2000

# -----------------------------------------------------------------------------
# 5. Execution: automatic, approved pairs only
# -----------------------------------------------------------------------------
# Research candidates are excluded: an unapproved pair's fills would dilute the
# trial's evidence with markets no human confirmed are equivalent.
EVENT_ARB_TRIAL__AUTO_PAPER_TRADE=true
EVENT_ARB_TRIAL__PAPER_TRADE_RESEARCH_CANDIDATES=false
EVENT_ARB_TRIAL__OBSERVATION_ONLY=false

# Simulated arrival latency. These are the delays leg 1 and leg 2 wait before pricing,
# and in REST mode leg 2 re-fetches the book afterwards — so they are what makes the
# hedge result something other than a re-read of the detection snapshot.
EVENT_ARB_PAPER__LEG1_LATENCY_MS=250
EVENT_ARB_PAPER__LEG2_LATENCY_MS=400

# Leave the adverse-movement model at zero for a live trial. It exists for fixture
# replay, where the file cannot move; against a live venue a real re-fetch is the
# measurement, and modelling on top of it would relabel the result `modelled` and
# throw the measurement away.
EVENT_ARB_PAPER__ADVERSE_FILL_PCT=0
EVENT_ARB_PAPER__LEG2_ADVERSE_MODEL_PCT=0

# -----------------------------------------------------------------------------
# 6. Simulated capital and limits
# -----------------------------------------------------------------------------
# Per-account, not a pool: each named account opens at its own figure. Both legs of a
# Polymarket **US** trade settle in USD, so there is no USDC account in this trial.
EVENT_ARB_PAPER__STARTING_BALANCES='{"kalshi:USD":"10000","polymarket_us:USD":"10000"}'

# Every limit is finite. A limit left unset is not enforced, and an unbounded
# simulator accumulates exposure no operator would have taken.
EVENT_ARB_PAPER__MAX_TRADE_NOTIONAL=250
EVENT_ARB_PAPER__MAX_OPEN_NOTIONAL=1000
EVENT_ARB_PAPER__MAX_OPEN_UNHEDGED_QUANTITY=100
# Cash each account must retain. A trade that would take an account below this is
# refused rather than sized down, so the run cannot spend itself to zero unnoticed.
EVENT_ARB_PAPER__MIN_ACCOUNT_BALANCE=1000

# Detection thresholds. A first trial wants trades to look at, not a filter tuned for
# profitability, but the floor must stay above the buffers so a "profit" is not noise.
EVENT_ARB_OPPORTUNITY__MIN_NET_PROFIT_USD=1.00
EVENT_ARB_OPPORTUNITY__MIN_RETURN_PCT=0.5
EVENT_ARB_OPPORTUNITY__MAX_QUANTITY=100

# -----------------------------------------------------------------------------
# 7. Watchdog
# -----------------------------------------------------------------------------
# Refresh and scan pause after 3 consecutive failures and stop the run at 12. An
# execution failure escalates straight to a stop regardless of these: pausing
# execution because execution failed suppresses the only thing that could clear it.
# A failed accounting write is an execution failure, so it ends the run.
EVENT_ARB_TRIAL__PAUSE_AFTER_CONSECUTIVE_FAILURES=3
EVENT_ARB_TRIAL__STOP_AFTER_CONSECUTIVE_FAILURES=12
EVENT_ARB_TRIAL__HEALTH_CHECK_INTERVAL_SECONDS=30

# -----------------------------------------------------------------------------
# 8. Storage and retention
# -----------------------------------------------------------------------------
# A dedicated database. Never point a trial at ./data/event_arb.db: that file is at an
# older revision and a trial must not be the thing that migrates it.
EVENT_ARB_DATABASE_URL=sqlite+aiosqlite:///./data/trial-rest-us-v1.db

# Bounded snapshot retention is required by the Kalshi Developer Agreement §3.1.
EVENT_ARB_TRIAL__SNAPSHOT_RETENTION_HOURS=72
EVENT_ARB_TRIAL__OPPORTUNITY_RETENTION_DAYS=90
EVENT_ARB_TRIAL__PAPER_TRADE_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# 9. Dashboard
# -----------------------------------------------------------------------------
# Approval happens here, and only here. Set a token: the approve endpoint is the one
# route that can change what the trial is allowed to trade.
EVENT_ARB_API_HOST=127.0.0.1
EVENT_ARB_API_PORT=8000
# EVENT_ARB_API_AUTH_TOKEN=<set to a value you generate; do not commit it>
#
# Generate one with:  openssl rand -hex 32
# `config/trial.env` is ignored by an exact .gitignore rule; confirm with
#   git check-ignore -v config/trial.env
# before you put a token in it. With a token set, the pair review page prints the
# approval curl including the bearer header, read from the environment rather than pasted.

# Review-only: serve the dashboard for review and approval and refuse to start any trial,
# whatever section 1 says. Use this whenever you open the dashboard to approve a pair —
# this file enables the trial, so a plain `serve` against a database that already holds an
# approved pair would start paper trading as a side effect of looking at it, and would be
# a second runner if a CLI trial is already going.
#
#   EVENT_ARB_REVIEW_ONLY=1 .venv/bin/event-arb serve
#
# Left unset here deliberately: it belongs on the review command, not in the trial's own
# configuration, so the trial run in the runbook is not silently disabled by it.
# EVENT_ARB_REVIEW_ONLY=1
