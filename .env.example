# ============================================================
# event-arb example configuration - PLACEHOLDERS ONLY.
# Copy to .env and fill in locally. NEVER commit a real .env.
# ============================================================

EVENT_ARB_ENV=local
EVENT_ARB_LOG_LEVEL=INFO
EVENT_ARB_LOG_FORMAT=json

# ---- Database ----
# Local dev default (SQLite). Production should use PostgreSQL.
EVENT_ARB_DATABASE_URL=sqlite+aiosqlite:///./data/event_arb.db
# EVENT_ARB_DATABASE_URL=postgresql+psycopg://event_arb:CHANGE_ME@localhost:5432/event_arb

# ---- HTTP / dashboard ----
EVENT_ARB_API_HOST=127.0.0.1
EVENT_ARB_API_PORT=8000
# The dashboard has no read authentication and its approval endpoint changes state.
# Binding anywhere other than loopback requires a bearer token; startup fails otherwise.
EVENT_ARB_API_AUTH_TOKEN=
# Set only when exposure is restricted outside the process (loopback-only container port
# mapping, or an authenticating reverse proxy). Not a way to skip authentication.
EVENT_ARB_API_BIND_IS_EXTERNALLY_RESTRICTED=false

# ---- Data source mode ----
# fixture = replay recorded/synthetic fixtures (default, no network)
# live    = read-only live market data (requires credentials below)
EVENT_ARB_DATA_SOURCE=fixture

# Ingestion mode. rest_polling is the ONLY credential-free option: both venues serve
# market data over unauthenticated REST but authenticate the WebSocket handshake even for
# public channels. Selecting websocket without credentials fails closed.
EVENT_ARB_INGESTION_MODE=rest_polling

# ---- Kalshi (read-only market data) ----
# Environment: demo | prod
EVENT_ARB_KALSHI__ENVIRONMENT=demo
EVENT_ARB_KALSHI__API_KEY_ID=00000000-0000-0000-0000-000000000000
# Path to an RSA private key file. The key itself must NEVER be committed.
EVENT_ARB_KALSHI__PRIVATE_KEY_PATH=/absolute/path/to/kalshi_private_key.pem

# ---- Polymarket product selection ----
# Polymarket US and Polymarket Global are separate legal entities and APIs. US is the
# intended target and its public read-only REST adapter IS implemented. Live mode is
# permitted with ingestion_mode=rest_polling, which needs no credentials. Selecting
# websocket ingestion fails closed, because the US WebSocket is on the authenticated API.
EVENT_ARB_POLYMARKET__PRODUCT=us
EVENT_ARB_POLYMARKET__GLOBAL_TERMS_ELIGIBILITY_CONFIRMED=false

# ---- Polymarket Global legacy adapter (read-only; not for US operators) ----
EVENT_ARB_POLYMARKET__GLOBAL_CLOB_BASE_URL=https://clob.polymarket.com
EVENT_ARB_POLYMARKET__GLOBAL_GAMMA_BASE_URL=https://gamma-api.polymarket.com
EVENT_ARB_POLYMARKET__GLOBAL_WS_URL=wss://ws-subscriptions-clob.polymarket.com/ws/market
EVENT_ARB_POLYMARKET__GLOBAL_GEOBLOCK_URL=https://polymarket.com/api/geoblock

# ---- Opportunity thresholds ----
EVENT_ARB_OPPORTUNITY__MIN_NET_PROFIT_USD=0.50
EVENT_ARB_OPPORTUNITY__MIN_RETURN_PCT=0.5
EVENT_ARB_OPPORTUNITY__MAX_BOOK_AGE_MS=2000
EVENT_ARB_OPPORTUNITY__SLIPPAGE_BUFFER_PCT=0.5
EVENT_ARB_OPPORTUNITY__OPERATIONAL_COST_USD=0.10
EVENT_ARB_OPPORTUNITY__MAX_QUANTITY=100
EVENT_ARB_OPPORTUNITY__ALERT_COOLDOWN_SECONDS=300

# ---- Paper execution ----
# Simulated network latency before each leg reads the book. In REST-polling mode the
# scanner goes back to the venue after this delay, which costs TWO extra order-book
# requests per simulated trade against your rate limit (docs/operations.md).
EVENT_ARB_PAPER__LEG1_LATENCY_MS=250
EVENT_ARB_PAPER__LEG2_LATENCY_MS=400
# Synthetic adverse move applied to leg 2 only, so fixture replay can exercise hedge
# failure — a fixture file cannot move, so an honest re-read proves nothing about it.
# Any trade run with this above zero is graded "modelled" and cannot support a hedge-rate
# claim. Leave at 0 to get an honest "unchanged_reread" instead of a synthetic number.
EVENT_ARB_PAPER__LEG2_ADVERSE_MODEL_PCT=0
# Required whenever the rate above is non-zero: name the observation it was calibrated
# from (venue, market, date range, sample size). An uncalibrated rate is a guess.
EVENT_ARB_PAPER__LEG2_ADVERSE_MODEL_SOURCE=

# ---- Trial (watched pairs) ----
# Run the autonomous ingest/scan/paper-execute loops. Off by default: a trial should be
# started deliberately, not by merely launching the dashboard. `event-arb trial` runs it
# from the CLI regardless of this flag.
EVENT_ARB_TRIAL__ENABLED=false
# A trial watches a handful of human-reviewed pairs named by venue identifier rather
# than discovering the whole venue. Book refresh is scoped to these markets, which is
# what keeps books fresh enough to be worth scanning.
# JSON list; each entry needs kalshi_market_id and polymarket_market_id.
# EVENT_ARB_TRIAL__WATCHED_PAIRS=[{"kalshi_market_id":"KXFEDDECISION-26SEP-CUT25","polymarket_market_id":"0xabc...","outcomes_inverted":false,"note":"rules reviewed 2026-08-22"}]
EVENT_ARB_TRIAL__REFRESH_INTERVAL_SECONDS=5
EVENT_ARB_TRIAL__SCAN_INTERVAL_SECONDS=5
EVENT_ARB_TRIAL__AUTO_PAPER_TRADE=true
EVENT_ARB_TRIAL__PAPER_TRADE_RESEARCH_CANDIDATES=false
# Bounded retention is required by the Kalshi Developer Agreement 3.1 (docs/compliance.md).
EVENT_ARB_TRIAL__SNAPSHOT_RETENTION_HOURS=72
# Detections are the trial's primary evidence, so they outlive a multi-week run with room
# for analysis. Left unbounded this table grew without limit: at a 5s cycle with two
# detections per cycle it projects to ~970,000 rows per 28 days.
EVENT_ARB_TRIAL__OPPORTUNITY_RETENTION_DAYS=90
# Paper trades are far rarer and record simulated execution, so they are kept longer.
EVENT_ARB_TRIAL__PAPER_TRADE_RETENTION_DAYS=365

# ---- Alerts ----
EVENT_ARB_ALERTS__CONSOLE_ENABLED=true
EVENT_ARB_ALERTS__WEBHOOK_URL=
# Kalshi Developer Agreement 3.1 forbids sharing API-accessed data with third parties
# without prior written authorization. A webhook endpoint is a third party. Leave false
# unless you hold that authorization. See docs/compliance.md.
EVENT_ARB_ALERTS__ALLOW_THIRD_PARTY_MARKET_DATA=false

# ============================================================
# LIVE TRADING - DISABLED. Phase 7 is not implemented.
# Leaving these false/empty is required for safe operation.
# ============================================================
EVENT_ARB_TRADING_ENABLED=false
EVENT_ARB_TRADING_CONFIRMATION_PHRASE=
